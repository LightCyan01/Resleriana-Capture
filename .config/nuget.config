<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
    <add key="Samboy" value="https://nuget.samboy.dev/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="BepInEx"><package pattern="Il2CppInterop.ReferenceLibs" /></packageSource>
    <packageSource key="Samboy"><package pattern="Samboy063.*" /></packageSource>
  </packageSourceMapping>
</configuration>
